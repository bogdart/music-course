{
  "phases": [
    {
      "id": "p1",
      "title": "Foundations",
      "weeks": [
        1,
        8
      ],
      "goal": "Play, name and hear notes; octave equivalence; intervals to the octave; major scale; major/minor triads; steady time; first melodies and first DAW sketch."
    },
    {
      "id": "p2",
      "title": "Harmony & Songs",
      "weeks": [
        9,
        16
      ],
      "goal": "Minor keys, all intervals, 7th chords, inversions, functional harmony, pop progressions; hear bass and chord roots; both hands; bass clef; first pop analyses."
    },
    {
      "id": "p3",
      "title": "Songwriting & Arrangement",
      "weeks": [
        17,
        26
      ],
      "goal": "Write complete songs: form, hook, melody, harmony, bass, drums, layering; arrange; transcribe simple melodies and bass lines."
    },
    {
      "id": "p4",
      "title": "Composition Studio & Jazz",
      "weeks": [
        27,
        40
      ],
      "goal": "Fluent composition across styles; jazz harmony and voicings; improvisation basics; production-minded arrangement; portfolio."
    },
    {
      "id": "p5",
      "title": "Transcription & Mastery",
      "weeks": [
        41,
        52
      ],
      "goal": "Decompose real pop songs by ear and write finished songs quickly and reliably."
    }
  ],
