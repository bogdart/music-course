{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
