{
  "name": "@music/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@music/content-schema": "*",
    "@music/core": "*",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
